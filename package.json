{
  "name": "retrogemini",
  "version": "1.1.0",
  "description": "Self-hosted, real-time collaborative retrospectives and team health checks",
  "type": "module",
  "license": "Unlicense",
  "repository": {
    "type": "git",
    "url": "https://github.com/republique-et-canton-de-geneve/RetroGemini.git"
  },
  "keywords": [
    "retrospective",
    "agile",
    "scrum",
    "team",
    "collaboration",
    "health-check",
    "self-hosted"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "docker:build": "docker build -t team-retrospective .",
    "docker:run": "docker run -p 8080:8080 team-retrospective",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:all": "node scripts/coverage-scope.mjs",
    "test:ui": "vitest --ui",
    "lint": "node scripts/lint.mjs",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "security:audit": "npm audit --audit-level=moderate",
    "security:fix": "npm audit fix",
    "test:e2e": "npx playwright test",
    "test:e2e:prod": "npx playwright test --config=playwright.prod.config.ts",
    "test:load": "node loadtest/run.js",
    "ci": "npm run lint && npm run type-check && npm run test && npm run build",
    "prepare": "node -e \"import('husky').catch((e) => { if (e.code !== 'ERR_MODULE_NOT_FOUND' && e.code !== 'MODULE_NOT_FOUND') throw e; })\"",
    "test:e2e:headed": "npx playwright test --headed --project=chromium",
    "test:e2e:debug": "npx playwright test --debug --project=chromium"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{js,jsx}": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "fast-xml-parser": "^5.3.4",
    "qs": ">=6.14.1",
    "tar": ">=7.5.3",
    "ws": ">=8.21.0",
    "eslint-plugin-react-hooks": {
      "eslint": "$eslint"
    },
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  },
  "dependencies": {
    "@socket.io/postgres-adapter": "^0.5.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "nodemailer": "^9.0.5",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "redis": "^6.2.1",
    "socket.io": "^4.8.2",
    "socket.io-client": "^4.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.3",
    "eslint": "^10.8.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.3"
  },
  "homepage": "https://github.com/republique-et-canton-de-geneve/RetroGemini#readme",
  "bugs": {
    "url": "https://github.com/republique-et-canton-de-geneve/RetroGemini/issues"
  }
}
