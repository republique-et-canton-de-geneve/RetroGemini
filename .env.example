# RetroGemini Configuration
# Copy this file to .env and adjust values for your environment
# All variables are optional - the application works with defaults

# =============================================================================
# Server Configuration
# =============================================================================

# Port the server listens on (default: 3000 in dev, 8080 in Docker)
# PORT=8080

# Node environment (development | production)
# NODE_ENV=production

# Express "trust proxy" setting, used for correct client IPs behind a reverse
# proxy (rate limiting relies on it). Accepts true/false or a hop count.
# Default: 1 when NODE_ENV=production, false otherwise.
# TRUST_PROXY=1

# =============================================================================
# Data Persistence
# =============================================================================

# The application supports two database backends:
#   1. PostgreSQL (recommended for multi-pod/production deployments)
#   2. SQLite (for development or single-pod deployments)
#
# PostgreSQL is used if DATABASE_URL or POSTGRES_HOST is set. Otherwise, SQLite.

# PostgreSQL connection - Option 1: Full URL
# DATABASE_URL=postgresql://retrogemini:password@postgresql:5432/retrogemini

# PostgreSQL connection - Option 2: Individual variables (for K8s/OpenShift secrets)
# POSTGRES_HOST=postgresql
# POSTGRES_PORT=5432
# POSTGRES_USER=retrogemini
# POSTGRES_PASSWORD=password
# POSTGRES_DB=retrogemini

# SQLite database path (used when DATABASE_URL is not set)
# The server tries these locations in order:
#   1. DATA_STORE_PATH (if set)
#   2. /data/data.sqlite (for mounted volumes)
#   3. /tmp/data.sqlite (ephemeral fallback - data lost on restart!)
#   4. ./data.sqlite (local file)
#
# For single-pod production, mount a persistent volume at /data
# DATA_STORE_PATH=/data/data.sqlite

# =============================================================================
# Scaling & Performance Tuning (Optional)
# =============================================================================

# Maximum PostgreSQL connections per pod (default: 10). Raise it when many teams
# run retrospectives concurrently and the pool becomes a bottleneck; keep it
# under your database's max_connections divided by the number of pods.
# PG_POOL_MAX=10

# Maximum number of live sessions held in each pod's in-memory cache (default:
# 500). Session state is always recoverable from the database, so this only
# bounds memory; the least-recently-used session is evicted past the limit.
# SESSION_CACHE_MAX=500

# Maximum Socket.IO message size in bytes (default: 1000000, i.e. 1 MB). Caps
# the size of a single session update a client may push.
# SOCKET_MAX_BUFFER_SIZE=1000000

# Per-socket flood protection for live `update-session` writes (token bucket).
# SOCKET_UPDATE_RATE is the sustained writes/second allowed per client and
# SOCKET_UPDATE_BURST the momentary burst allowed above it (defaults to 2x the
# rate when unset). DISABLED by default (rate 0): enabling it is a
# capacity-sensitive change to the session-sync path, so run the load test
# (loadtest/README.md) at your real cadence before relying on it. A throttled
# write is never dropped — the sender is healed with the authoritative state
# and re-sends. Timer sync writes at ~1/s, so 20 is a generous starting point.
# SOCKET_UPDATE_RATE=0
# SOCKET_UPDATE_BURST=40

# Minimum interval, in milliseconds, between refreshes of a team's
# lastConnectionDate when participants join (default: 300000, i.e. 5 minutes).
# Prevents a write storm when a whole session reconnects at once (e.g. after a
# rolling update). Set to 0 to update on every join.
# LAST_CONNECTION_DEBOUNCE_MS=300000

# Debounce window, in milliseconds, for coalescing session-roster rebroadcasts
# (default: 250). Each join/leave otherwise triggers a cross-pod fetchSockets()
# plus a full-roster broadcast to the room; during a reconnect stampede (a whole
# pod's clients rejoining after a rolling update) that is O(N^2) messages and N
# cross-pod fetches. Coalescing caps it to at most one rebuild + broadcast per
# room per window (the immediate member-joined/left signals still update the UI).
# It never drops or delays a user action — only a presence broadcast whose
# content is unchanged — so it is on by default. Set to 0 to broadcast the roster
# synchronously on every join/leave (the pre-optimization behaviour).
# ROSTER_BROADCAST_DEBOUNCE_MS=250

# =============================================================================
# Multi-Pod Socket.IO Adapter (Optional)
# =============================================================================

# With more than one pod, Socket.IO needs a shared adapter so session updates
# broadcast across pods. Redis is preferred when configured; otherwise the
# PostgreSQL adapter is used automatically when PostgreSQL is the data store.
# Single-pod deployments need neither (in-memory adapter).

# Redis connection - Option 1: Full URL
# REDIS_URL=redis://:password@redis:6379

# Redis connection - Option 2: Individual variables
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_PASSWORD=password

# =============================================================================
# Email Configuration (Optional)
# =============================================================================

# SMTP server for sending invitation emails
# If not configured, email invitations are disabled (link sharing still works)

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-username
# SMTP_PASS=your-password
# FROM_EMAIL=noreply@example.com

# =============================================================================
# Wi-Fi QR Code (Optional)
# =============================================================================

# When both WIFI_SSID and WIFI_PASSWORD are set, a "WI-FI" tab appears in the
# invite modal showing a QR code that participants can scan to connect to the
# local network. Useful for air-gapped or internal deployments where users
# must join a specific Wi-Fi network to access the application.

# WIFI_SSID=RetroGemini-Network
# WIFI_PASSWORD=your-wifi-password

# =============================================================================
# Corporate Proxy Configuration (Optional)
# =============================================================================

# HTTP/HTTPS proxy settings for outbound connections
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.internal.domain

# =============================================================================
# TLS/SSL Configuration (Optional)
# =============================================================================

# Custom CA certificates for corporate MITM proxies
# Point to a PEM file containing your organization's CA certificate(s)
# NODE_EXTRA_CA_CERTS=/path/to/corporate-ca.crt

# WARNING: Only use this in development environments!
# Disables TLS certificate verification (insecure)
# NODE_TLS_REJECT_UNAUTHORIZED=0

# =============================================================================
# Security Configuration (Optional)
# =============================================================================

# Password to enable super admin panel and API endpoints (disabled if unset)
# SUPER_ADMIN_PASSWORD=change-me

# Stable secret for HMAC-signed team and super-admin session tokens, and for
# the invite credentials embedded in invite links.
# Set the same value on every pod so sessions AND newly minted invite links
# survive restarts and non-sticky routing.
# If unset, a process-local random secret is used: sessions and new invite
# links stop working after every restart.
# IMPORTANT for zero-downtime deployments: the WebSocket join handshake
# authenticates with this same token, so without a stable shared secret a
# rolling update drops live participants out of an in-progress session.
# SESSION_TOKEN_SECRET=change-me-to-a-long-random-secret

# Restrict WebSocket CORS to specific origin(s)
# Default: "*" (allow all origins - suitable for self-hosted deployments)
# For production behind a known domain, set to your application URL
# CORS_ORIGIN=https://retro.example.com

# Maximum team-create / restore-session requests allowed per IP per 15 minutes
# (default: 5). Raise it only for test environments that create many teams.
# AUTH_RATE_LIMIT_MAX=5

# Maximum invitation emails one team may send per hour (default: 200).
# /api/send-invite requires the team credential, so this is a per-team quota
# (not per IP) - a whole office shares one egress IP, and a facilitator must be
# able to invite a large group in one batch. It caps how much mail a single
# leaked team password can push through your SMTP identity. Counted per pod.
# INVITE_MAX_PER_TEAM_PER_HOUR=200

# =============================================================================
# Data Backup Configuration (Optional)
# =============================================================================

# Enable automatic server-side backups (default: true)
# BACKUP_ENABLED=true

# Hours between automatic backups (default: 24)
# BACKUP_INTERVAL_HOURS=24

# Maximum number of automatic backups to keep (protected backups don't count) (default: 7)
# BACKUP_MAX_COUNT=7

# Create a backup snapshot when the server starts (default: true)
# BACKUP_ON_STARTUP=true

# Maximum uploaded restore archive body size in MB (default: 128)
# RESTORE_MAX_BODY_MB=128

# Maximum decompressed restore archive size in MB (default: 512)
# RESTORE_MAX_DECOMPRESSED_MB=512
